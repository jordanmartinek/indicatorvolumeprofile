//@version=5
indicator("Custom Volume Profile (Step / Session)", shorttitle="CVP", overlay=true, max_boxes_count=500, max_lines_count=500, max_bars_back=5000)

// ============================================================================
// INPUTS
// ============================================================================
G1 = "Profile Mode"
mode     = input.string("Step", "Mode", options=["Step", "Session"], group=G1, tooltip="Step = new profile every N time units. Session = one profile per trading session.")
stepTf   = input.timeframe("60", "Step Interval (Step mode)", group=G1, tooltip="Examples: 15, 60, 240, D, W, M. A new profile starts each time this interval rolls over. Must be >= chart timeframe.")
sessPick = input.string("New York", "Session (Session mode)", options=["Asia", "London", "New York", "Custom"], group=G1)
sessCust = input.session("0930-1600", "Custom Session", group=G1)
tz       = input.string("America/New_York", "Session Timezone", group=G1, tooltip="Presets (in New York time): Asia 2000-0400, London 0300-1130, New York 0930-1600.")

G2 = "Profile Calculation"
rows     = input.int(24, "Rows per Profile", minval=5, maxval=100, group=G2, tooltip="Boxes used per profile. Total boxes are capped at 500 by TradingView: rows * (max profiles + 1) must be <= 500.")
vaPct    = input.float(70.0, "Value Area %", minval=10, maxval=100, step=1, group=G2)
maxProf  = input.int(15, "Max Profiles Kept", minval=1, maxval=100, group=G2)

G3 = "Appearance"
widthPct = input.int(40, "Histogram Width (% of period length)", minval=5, maxval=100, group=G3)
side     = input.string("Left", "Histogram Anchor", options=["Left", "Right"], group=G3)
vaCol    = input.color(color.new(color.blue, 55), "Value Area Color", group=G3)
outCol   = input.color(color.new(color.gray, 75), "Outside Value Area Color", group=G3)
showPoc  = input.bool(true, "Show POC", group=G3, inline="poc")
pocCol   = input.color(color.orange, "", group=G3, inline="poc")
showVa   = input.bool(true, "Show VAH / VAL Lines", group=G3, inline="va")
vaLnCol  = input.color(color.new(color.blue, 20), "", group=G3, inline="va")
extPoc   = input.bool(false, "Extend Developing POC/VAH/VAL to the right", group=G3)

// ============================================================================
// SESSION / PERIOD LOGIC
// ============================================================================
sessStr = switch sessPick
    "Asia"     => "2000-0400"
    "London"   => "0300-1130"
    "New York" => "0930-1600"
    => sessCust

isStep  = mode == "Step"
inSess  = not na(time(timeframe.period, sessStr, tz))
newStep = timeframe.change(stepTf)

// Close the running profile when a new period begins / the session ends
closeCond = isStep ? newStep : (not inSess or not inSess[1])
// Add this bar to the running profile
addCond   = isStep or inSess

// ============================================================================
// STATE
// ============================================================================
var float[] hs = array.new_float()
var float[] ls = array.new_float()
var float[] vs = array.new_float()
var int startBar = na
var int lastBar  = na

var box[]  hBox = array.new_box()
var line[] hLn  = array.new_line()
var box[]  dBox = array.new_box()
var line[] dLn  = array.new_line()

// ============================================================================
// RENDER: builds the profile from hs/ls/vs and pushes drawings into bx / ln
// ============================================================================
render(int sb, int eb, box[] bx, line[] ln, bool dev) =>
    int n = array.size(hs)
    float hi = array.max(hs)
    float lo = array.min(ls)
    if hi - lo < syminfo.mintick
        hi := lo + syminfo.mintick
    float stp = (hi - lo) / rows

    float[] bins = array.new_float(rows, 0.0)
    for i = 0 to n - 1
        float h = array.get(hs, i)
        float l = array.get(ls, i)
        float v = nz(array.get(vs, i))
        int r0 = math.max(0, math.min(rows - 1, int(math.floor((l - lo) / stp))))
        int r1 = math.max(0, math.min(rows - 1, int(math.floor((h - lo) / stp))))
        float share = v / (r1 - r0 + 1)
        for r = r0 to r1
            array.set(bins, r, array.get(bins, r) + share)

    float mx = array.max(bins)
    int poc = array.indexof(bins, mx)
    float total = array.sum(bins)
    float target = total * vaPct / 100.0

    int vl = poc
    int vh = poc
    float acc = mx
    while acc < target and (vl > 0 or vh < rows - 1)
        float dn = vl > 0 ? array.get(bins, vl - 1) : -1.0
        float up = vh < rows - 1 ? array.get(bins, vh + 1) : -1.0
        if up >= dn
            vh += 1
            acc += up
        else
            vl -= 1
            acc += dn

    int periodBars = eb - sb + 1
    int w = math.max(2, int(math.round(periodBars * widthPct / 100.0)))

    for r = 0 to rows - 1
        float b = array.get(bins, r)
        int len = mx > 0 ? math.max(1, int(math.round(w * b / mx))) : 1
        int xl = side == "Left" ? sb : eb - len
        int xr = side == "Left" ? sb + len : eb
        color c = (r >= vl and r <= vh) ? vaCol : outCol
        array.push(bx, box.new(xl, lo + (r + 1) * stp, xr, lo + r * stp, border_color=na, bgcolor=c, xloc=xloc.bar_index))

    float pocP = lo + (poc + 0.5) * stp
    float vahP = lo + (vh + 1) * stp
    float valP = lo + vl * stp
    extend ext = (dev and extPoc) ? extend.right : extend.none
    array.push(ln, line.new(sb, pocP, eb, pocP, xloc=xloc.bar_index, extend=ext, color=showPoc ? pocCol : na, width=2))
    array.push(ln, line.new(sb, vahP, eb, vahP, xloc=xloc.bar_index, extend=ext, color=showVa ? vaLnCol : na, style=line.style_dashed))
    array.push(ln, line.new(sb, valP, eb, valP, xloc=xloc.bar_index, extend=ext, color=showVa ? vaLnCol : na, style=line.style_dashed))

// ============================================================================
// MAIN LOOP
// ============================================================================
// 1) Finalize the previous profile
if closeCond and array.size(hs) > 0
    render(startBar, lastBar, hBox, hLn, false)
    array.clear(hs)
    array.clear(ls)
    array.clear(vs)
    // Trim oldest profiles
    while array.size(hBox) > maxProf * rows
        box.delete(array.shift(hBox))
    while array.size(hLn) > maxProf * 3
        line.delete(array.shift(hLn))

// 2) Accumulate current bar
if addCond
    if array.size(hs) == 0
        startBar := bar_index
    array.push(hs, high)
    array.push(ls, low)
    array.push(vs, volume)
    lastBar := bar_index

// 3) Developing (live) profile
if barstate.islast
    while array.size(dBox) > 0
        box.delete(array.pop(dBox))
    while array.size(dLn) > 0
        line.delete(array.pop(dLn))
    if array.size(hs) > 0
        render(startBar, bar_index, dBox, dLn, true)
