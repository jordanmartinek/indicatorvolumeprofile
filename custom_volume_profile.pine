//@version=6
indicator("Custom Volume Profile (Step / Session)", shorttitle="CVP", overlay=true, max_boxes_count=500, max_lines_count=500, max_polylines_count=100, max_bars_back=5000)

// ============================================================================
// INPUTS
// ============================================================================
G1 = "Profile Mode"
mode     = input.string("Step", "Mode", options=["Step", "Session"], group=G1, tooltip="Step = new profile every N time units. Session = one profile per trading session.")
stepTf   = input.timeframe("60", "Step Interval (Step mode)", group=G1, tooltip="Examples: 15, 60, 240, D, W, M. A new profile starts each time this interval rolls over. Must be >= chart timeframe.")
sessPick = input.string("New York", "Session (Session mode)", options=["Asia", "London", "New York", "Custom"], group=G1)
sessCust = input.session("0930-1600", "Custom Session", group=G1)
tz       = input.string("America/New_York", "Session Timezone", group=G1, tooltip="Presets (in New York time): Asia 2000-0400, London 0300-1130, New York 0930-1600.")
dayOnly  = input.bool(false, "Only Show a Specific Day", group=G1, inline="day", tooltip="Only builds profiles whose period STARTS on this date (in the Session Timezone). Session mode: that day's session. Step mode: every step profile of that day. Format: YYYY-MM-DD. Note: Asia (2000-0400) starts the evening before the trading day it belongs to.")
dayStr   = input.string("2026-11-12", "", group=G1, inline="day")

G2 = "Rows & Distribution"
rowMode  = input.string("Ticks per Row", "Row Sizing", options=["Ticks per Row", "Fixed Row Count"], group=G2, tooltip="Ticks per Row = each row is an exact price level (e.g. 4 ticks = 1 point on NQ/ES). Fixed = the profile range split into N rows.")
tpr      = input.int(4, "Ticks per Row", minval=1, maxval=1000, group=G2)
rows     = input.int(50, "Fixed Row Count", minval=5, maxval=250, group=G2)
dist     = input.string("Body Weighted", "Volume Distribution", options=["Body Weighted", "Triangular (Close)", "Uniform"], group=G2, tooltip="How each candle's volume is spread over its range. Uniform = even (blocky). Body Weighted = more volume where the candle body traded. Triangular = peaks at the close.")
bodyW    = input.float(3.0, "Body Weight", minval=1, maxval=20, step=0.5, group=G2, tooltip="Body Weighted only: how much more volume a body row gets vs a wick row.")
useLtf   = input.bool(true, "Use Intrabar (Lower TF) Volume", group=G2, tooltip="Builds the profile from lower-timeframe candles. Ignored when the chart timeframe is not above the intrabar timeframe.")
ltf      = input.timeframe("1", "Intrabar Timeframe", group=G2, tooltip="Lower = sharper profile. Seconds (e.g. 15S) work on plans that support them. Use 5 or 15 for D / W / M steps.")

G3 = "Performance"
maxProf  = input.int(6, "Max Profiles Kept", minval=1, maxval=49, group=G3, tooltip="Boxes mode: 500 boxes are shared, so each profile can have up to 500 / (profiles + 1) rows. Fewer profiles = more rows each.")
lookback = input.int(1500, "Lookback (bars)", minval=100, maxval=20000, group=G3)
liveTick = input.bool(false, "Update Live Profile Every Tick", group=G3)
render   = input.string("Boxes", "Render Mode", options=["Boxes", "Polyline (experimental)"], group=G3)

G4 = "Value Area"
vaPct    = input.float(70.0, "Value Area %", minval=10, maxval=100, step=1, group=G4)

G5 = "Appearance"
colMode  = input.string("Value Area", "Color Mode", options=["Value Area", "Heatmap"], group=G5, tooltip="Heatmap colors each row by its volume, making high/low volume nodes stand out.")
widthPct = input.int(40, "Histogram Width (% of period length)", minval=5, maxval=100, group=G5)
side     = input.string("Left", "Histogram Anchor", options=["Left", "Right"], group=G5)
gapPct   = input.int(20, "Row Gap %", minval=0, maxval=80, group=G5, tooltip="Vertical gap between rows so each level is visually separate. 0 = solid.")
vaCol    = input.color(color.new(color.blue, 45), "Value Area Color", group=G5)
outCol   = input.color(color.new(color.gray, 65), "Outside Value Area Color", group=G5)
heatLo   = input.color(color.new(color.blue, 80), "Heatmap Low", group=G5, inline="heat")
heatHi   = input.color(color.new(color.yellow, 10), "High", group=G5, inline="heat")
hlPocRow = input.bool(true, "Highlight POC Row", group=G5)
showPoc  = input.bool(true, "Show POC Line", group=G5, inline="poc")
pocCol   = input.color(color.orange, "", group=G5, inline="poc")
showVa   = input.bool(true, "Show VAH / VAL Lines", group=G5, inline="va")
vaLnCol  = input.color(color.new(color.blue, 20), "", group=G5, inline="va")
extPoc   = input.bool(false, "Extend Developing POC/VAH/VAL to the right", group=G5)

// ============================================================================
// SETUP
// ============================================================================
sessStr = switch sessPick
    "Asia"     => "2000-0400"
    "London"   => "0300-1130"
    "New York" => "0930-1600"
    => sessCust

usePoly  = render != "Boxes"
fixedRow = rowMode == "Fixed Row Count"
effProf  = (usePoly or not fixedRow) ? maxProf : math.max(1, math.min(maxProf, int(math.floor(500.0 / rows)) - 1))
rowCap   = usePoly ? 1500 : math.max(5, int(math.floor(500.0 / (effProf + 1))))

isStep  = mode == "Step"
inSess  = not na(time(timeframe.period, sessStr, tz))
newStep = timeframe.change(stepTf)

closeCond = isStep ? newStep : (not inSess or not inSess[1])
addCond   = isStep or inSess
// Bar on which a new period begins
startCond = isStep ? (newStep or barstate.isfirst) : (inSess and not inSess[1])

// ---- Specific-day filter (YYYY-MM-DD parsed in the Session Timezone) ----
string[] dParts = str.split(str.trim(dayStr), "-")
int tY = array.size(dParts) == 3 ? int(str.tonumber(array.get(dParts, 0))) : na
int tM = array.size(dParts) == 3 ? int(str.tonumber(array.get(dParts, 1))) : na
int tD = array.size(dParts) == 3 ? int(str.tonumber(array.get(dParts, 2))) : na
int dayStart = na(tY) or na(tM) or na(tD) ? na : timestamp(tz, tY, tM, tD, 0, 0)
bool barOnDay = year(time, tz) == tY and month(time, tz) == tM and dayofmonth(time, tz) == tD
// Loose window around the target day so only nearby bars do any work
bool nearDay = not na(dayStart) and time >= dayStart - 86400000 and time < dayStart + 2 * 86400000

inRange   = dayOnly ? nearDay : bar_index >= last_bar_index - lookback

// Decide at the start of each period whether it should be built
var bool periodOk = true
if startCond
    periodOk := not dayOnly or barOnDay

ltfOk = useLtf and timeframe.in_seconds(ltf) < timeframe.in_seconds()
barMs = timeframe.in_seconds() * 1000

// ============================================================================
// STATE
// ============================================================================
var float[] hs = array.new_float()
var float[] ls = array.new_float()
var float[] os = array.new_float()
var float[] cs = array.new_float()
var float[] vs = array.new_float()
var int startT = na
var int lastT  = na

var box[]      hBx  = array.new<box>()
var int[]      hCnt = array.new<int>()     // boxes per historical profile
var polyline[] hPl  = array.new<polyline>()
var line[]     hLn  = array.new<line>()
var box[]      dBx  = array.new<box>()
var polyline[] dPl  = array.new<polyline>()
var line[]     dLn  = array.new<line>()

// ============================================================================
// RENDER (returns number of boxes created)
// ============================================================================
drawProfile(int st, int et, box[] bx, polyline[] pl, line[] ln, bool dev) =>
    int n = array.size(hs)
    float hi = array.max(hs)
    float lo = array.min(ls)
    if hi - lo < syminfo.mintick
        hi := lo + syminfo.mintick

    // ---- Row grid ----
    int nr = math.min(rows, rowCap)
    float stp = (hi - lo) / nr
    if not fixedRow
        float rs = tpr * syminfo.mintick
        float lo2 = math.floor(lo / rs) * rs
        int need = math.max(1, int(math.ceil((hi - lo2) / rs)))
        if need <= rowCap
            lo := lo2
            nr := need
            stp := rs
            hi := lo + nr * stp
        else
            nr := rowCap
            stp := (hi - lo) / nr

    // ---- Volume distribution ----
    float[] bins = array.new_float(nr, 0.0)
    for i = 0 to n - 1
        float h = array.get(hs, i)
        float l = array.get(ls, i)
        float o = array.get(os, i)
        float c = array.get(cs, i)
        float v = nz(array.get(vs, i))
        int r0 = math.max(0, math.min(nr - 1, int(math.floor((l - lo) / stp))))
        int r1 = math.max(0, math.min(nr - 1, int(math.floor((h - lo) / stp))))
        if r0 == r1 or dist == "Uniform"
            float share = v / (r1 - r0 + 1)
            for r = r0 to r1
                array.set(bins, r, array.get(bins, r) + share)
        else
            float bt = math.max(o, c)
            float bb = math.min(o, c)
            float span = h - l + stp
            float wsum = 0.0
            for r = r0 to r1
                float rb = lo + r * stp
                float mid = rb + stp * 0.5
                float w = dist == "Body Weighted" ? ((rb + stp >= bb and rb <= bt) ? bodyW : 1.0) : (1.0 - math.abs(mid - c) / span)
                wsum += w
            for r = r0 to r1
                float rb = lo + r * stp
                float mid = rb + stp * 0.5
                float w = dist == "Body Weighted" ? ((rb + stp >= bb and rb <= bt) ? bodyW : 1.0) : (1.0 - math.abs(mid - c) / span)
                array.set(bins, r, array.get(bins, r) + v * w / wsum)

    float mx = array.max(bins)
    int poc = array.indexof(bins, mx)
    float total = array.sum(bins)
    float target = total * vaPct / 100.0

    // ---- Value area ----
    int vl = poc
    int vh = poc
    float acc = mx
    while acc < target and (vl > 0 or vh < nr - 1)
        float dn = vl > 0 ? array.get(bins, vl - 1) : -1.0
        float up = vh < nr - 1 ? array.get(bins, vh + 1) : -1.0
        if up >= dn
            vh += 1
            acc += up
        else
            vl -= 1
            acc += dn

    // ---- Draw ----
    int widthMs = math.max(1, int((et - st) * widthPct / 100.0))
    bool left = side == "Left"
    int x0 = left ? st : et
    float gap = stp * gapPct / 200.0
    int cnt = 0

    if usePoly
        chart.point[] fullPts = array.new<chart.point>()
        chart.point[] vaPts   = array.new<chart.point>()
        array.push(fullPts, chart.point.from_time(x0, lo))
        array.push(vaPts, chart.point.from_time(x0, lo + vl * stp))
        for r = 0 to nr - 1
            int len = mx > 0 ? int(widthMs * array.get(bins, r) / mx) : 0
            int x = left ? x0 + len : x0 - len
            float yb = lo + r * stp
            float yt = yb + stp
            array.push(fullPts, chart.point.from_time(x, yb))
            array.push(fullPts, chart.point.from_time(x, yt))
            if r >= vl and r <= vh
                array.push(vaPts, chart.point.from_time(x, yb))
                array.push(vaPts, chart.point.from_time(x, yt))
        array.push(fullPts, chart.point.from_time(x0, hi))
        array.push(vaPts, chart.point.from_time(x0, lo + (vh + 1) * stp))
        array.push(pl, polyline.new(fullPts, false, true, xloc.bar_time, outCol, outCol))
        array.push(pl, polyline.new(vaPts, false, true, xloc.bar_time, vaCol, vaCol))
    else
        for r = 0 to nr - 1
            float b = array.get(bins, r)
            if b > 0
                int len = mx > 0 ? math.max(1, int(widthMs * b / mx)) : 1
                int xl = left ? x0 : x0 - len
                int xr = left ? x0 + len : x0
                color c = colMode == "Heatmap" ? color.from_gradient(b, 0, mx, heatLo, heatHi) : ((r >= vl and r <= vh) ? vaCol : outCol)
                if hlPocRow and r == poc
                    c := color.new(pocCol, 20)
                float yb = lo + r * stp + gap
                float yt = lo + (r + 1) * stp - gap
                array.push(bx, box.new(xl, yt, xr, yb, xloc=xloc.bar_time, border_color=c, border_width=0, bgcolor=c))
                cnt += 1

    float pocP = lo + (poc + 0.5) * stp
    float vahP = lo + (vh + 1) * stp
    float valP = lo + vl * stp
    string ext = (dev and extPoc) ? extend.right : extend.none
    array.push(ln, line.new(st, pocP, et, pocP, xloc=xloc.bar_time, extend=ext, color=showPoc ? pocCol : na, width=1))
    array.push(ln, line.new(st, vahP, et, vahP, xloc=xloc.bar_time, extend=ext, color=showVa ? vaLnCol : na, style=line.style_dashed))
    array.push(ln, line.new(st, valP, et, valP, xloc=xloc.bar_time, extend=ext, color=showVa ? vaLnCol : na, style=line.style_dashed))
    cnt

clearDev() =>
    while array.size(dBx) > 0
        box.delete(array.pop(dBx))
    while array.size(dPl) > 0
        polyline.delete(array.pop(dPl))
    while array.size(dLn) > 0
        line.delete(array.pop(dLn))

// ============================================================================
// INTRABAR DATA
// ============================================================================
float[] lh = na
float[] ll = na
float[] lo_ = na
float[] lc = na
float[] lv = na
if ltfOk and inRange
    [h_, l_, o_, c_, v_] = request.security_lower_tf(syminfo.tickerid, ltf, [high, low, open, close, volume])
    lh := h_
    ll := l_
    lo_ := o_
    lc := c_
    lv := v_

// ============================================================================
// MAIN LOOP
// ============================================================================
// 1) Finalize previous profile
if closeCond and array.size(hs) > 0
    int k = drawProfile(startT, lastT + barMs, hBx, hPl, hLn, false)
    array.push(hCnt, k)
    while array.size(hCnt) > effProf
        int d = array.shift(hCnt)
        if d > 0
            for j = 1 to d
                box.delete(array.shift(hBx))
    while array.size(hPl) > effProf * 2
        polyline.delete(array.shift(hPl))
    while array.size(hLn) > effProf * 3
        line.delete(array.shift(hLn))
    array.clear(hs)
    array.clear(ls)
    array.clear(os)
    array.clear(cs)
    array.clear(vs)

// 2) Accumulate current bar (intrabar candles if available, else the bar itself)
if addCond and inRange and periodOk
    if array.size(hs) == 0
        startT := time
    int m = ltfOk and not na(lh) ? array.size(lh) : 0
    if m > 0
        for i = 0 to m - 1
            float ih = array.get(lh, i)
            float il = array.get(ll, i)
            if not na(ih) and not na(il)
                array.push(hs, ih)
                array.push(ls, il)
                array.push(os, nz(array.get(lo_, i), il))
                array.push(cs, nz(array.get(lc, i), ih))
                array.push(vs, nz(array.get(lv, i)))
    else
        array.push(hs, high)
        array.push(ls, low)
        array.push(os, open)
        array.push(cs, close)
        array.push(vs, volume)
    lastT := time

// 3) Developing (live) profile – throttled to avoid redrawing on every tick
if barstate.islast and (liveTick or not barstate.isrealtime or barstate.isconfirmed or closeCond)
    clearDev()
    if array.size(hs) > 0
        drawProfile(startT, time + barMs, dBx, dPl, dLn, true)
