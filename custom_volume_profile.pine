//@version=6
indicator("Custom Volume Profile (Step / Session)", shorttitle="CVP", overlay=true, max_polylines_count=100, max_lines_count=500, max_bars_back=5000)

// ============================================================================
// INPUTS
// ============================================================================
G1 = "Profile Mode"
mode     = input.string("Step", "Mode", options=["Step", "Session"], group=G1, tooltip="Step = new profile every N time units. Session = one profile per trading session.")
stepTf   = input.timeframe("60", "Step Interval (Step mode)", group=G1, tooltip="Examples: 15, 60, 240, D, W, M. A new profile starts each time this interval rolls over. Must be >= chart timeframe.")
sessPick = input.string("New York", "Session (Session mode)", options=["Asia", "London", "New York", "Custom"], group=G1)
sessCust = input.session("0930-1600", "Custom Session", group=G1)
tz       = input.string("America/New_York", "Session Timezone", group=G1, tooltip="Presets (in New York time): Asia 2000-0400, London 0300-1130, New York 0930-1600.")

G2 = "Resolution"
rows     = input.int(100, "Rows per Profile", minval=5, maxval=500, group=G2, tooltip="More rows = finer price levels. Each profile is a single polyline, so there is no box limit.")
useLtf   = input.bool(true, "Use Intrabar (Lower TF) Volume", group=G2, tooltip="Builds the profile from lower-timeframe candles for far more accurate volume placement. Needs the chart timeframe to be above the intrabar timeframe.")
ltf      = input.timeframe("1", "Intrabar Timeframe", group=G2, tooltip="Must be lower than the chart timeframe. Lower = more accurate but heavier on long periods (day/week/month steps).")

G3 = "Value Area"
vaPct    = input.float(70.0, "Value Area %", minval=10, maxval=100, step=1, group=G3)
maxProf  = input.int(30, "Max Profiles Kept", minval=1, maxval=49, group=G3, tooltip="Each profile uses 2 polylines; TradingView caps scripts at 100.")

G4 = "Appearance"
widthPct = input.int(40, "Histogram Width (% of period length)", minval=5, maxval=100, group=G4)
side     = input.string("Left", "Histogram Anchor", options=["Left", "Right"], group=G4)
vaCol    = input.color(color.new(color.blue, 55), "Value Area Color", group=G4)
outCol   = input.color(color.new(color.gray, 70), "Outside Value Area Color", group=G4)
showPoc  = input.bool(true, "Show POC", group=G4, inline="poc")
pocCol   = input.color(color.orange, "", group=G4, inline="poc")
showVa   = input.bool(true, "Show VAH / VAL Lines", group=G4, inline="va")
vaLnCol  = input.color(color.new(color.blue, 20), "", group=G4, inline="va")
extPoc   = input.bool(false, "Extend Developing POC/VAH/VAL to the right", group=G4)

// ============================================================================
// SESSION / PERIOD LOGIC
// ============================================================================
sessStr = switch sessPick
    "Asia"     => "2000-0400"
    "London"   => "0300-1130"
    "New York" => "0930-1600"
    => sessCust

isStep  = mode == "Step"
inSess  = not na(time(timeframe.period, sessStr, tz))
newStep = timeframe.change(stepTf)

closeCond = isStep ? newStep : (not inSess or not inSess[1])
addCond   = isStep or inSess

ltfOk = useLtf and timeframe.in_seconds(ltf) < timeframe.in_seconds()
barMs = timeframe.in_seconds() * 1000

// ============================================================================
// STATE
// ============================================================================
var float[] hs = array.new_float()
var float[] ls = array.new_float()
var float[] vs = array.new_float()
var int startT = na
var int lastT  = na

var polyline[] hPl = array.new<polyline>()
var line[]     hLn = array.new<line>()
var polyline[] dPl = array.new<polyline>()
var line[]     dLn = array.new<line>()

// ============================================================================
// RENDER
// ============================================================================
render(int st, int et, polyline[] pl, line[] ln, bool dev) =>
    int n = array.size(hs)
    float hi = array.max(hs)
    float lo = array.min(ls)
    if hi - lo < syminfo.mintick
        hi := lo + syminfo.mintick
    float stp = (hi - lo) / rows

    // Distribute each candle's volume across the rows it spans
    float[] bins = array.new_float(rows, 0.0)
    for i = 0 to n - 1
        float h = array.get(hs, i)
        float l = array.get(ls, i)
        float v = nz(array.get(vs, i))
        int r0 = math.max(0, math.min(rows - 1, int(math.floor((l - lo) / stp))))
        int r1 = math.max(0, math.min(rows - 1, int(math.floor((h - lo) / stp))))
        float share = v / (r1 - r0 + 1)
        for r = r0 to r1
            array.set(bins, r, array.get(bins, r) + share)

    float mx = array.max(bins)
    int poc = array.indexof(bins, mx)
    float total = array.sum(bins)
    float target = total * vaPct / 100.0

    // Value area expansion from the POC
    int vl = poc
    int vh = poc
    float acc = mx
    while acc < target and (vl > 0 or vh < rows - 1)
        float dn = vl > 0 ? array.get(bins, vl - 1) : -1.0
        float up = vh < rows - 1 ? array.get(bins, vh + 1) : -1.0
        if up >= dn
            vh += 1
            acc += up
        else
            vl -= 1
            acc += dn

    // Time-based geometry gives sub-bar horizontal resolution
    int widthMs = math.max(1, int((et - st) * widthPct / 100.0))
    bool left = side == "Left"
    int x0 = left ? st : et

    chart.point[] fullPts = array.new<chart.point>()
    chart.point[] vaPts   = array.new<chart.point>()

    array.push(fullPts, chart.point.from_time(x0, lo))
    array.push(vaPts, chart.point.from_time(x0, lo + vl * stp))
    for r = 0 to rows - 1
        float b = array.get(bins, r)
        int len = mx > 0 ? int(widthMs * b / mx) : 0
        int x = left ? x0 + len : x0 - len
        float yb = lo + r * stp
        float yt = lo + (r + 1) * stp
        array.push(fullPts, chart.point.from_time(x, yb))
        array.push(fullPts, chart.point.from_time(x, yt))
        if r >= vl and r <= vh
            array.push(vaPts, chart.point.from_time(x, yb))
            array.push(vaPts, chart.point.from_time(x, yt))
    array.push(fullPts, chart.point.from_time(x0, hi))
    array.push(vaPts, chart.point.from_time(x0, lo + (vh + 1) * stp))

    array.push(pl, polyline.new(fullPts, curved=false, closed=true, xloc=xloc.bar_time, line_color=na, fill_color=outCol))
    array.push(pl, polyline.new(vaPts, curved=false, closed=true, xloc=xloc.bar_time, line_color=na, fill_color=vaCol))

    float pocP = lo + (poc + 0.5) * stp
    float vahP = lo + (vh + 1) * stp
    float valP = lo + vl * stp
    string ext = (dev and extPoc) ? extend.right : extend.none
    array.push(ln, line.new(st, pocP, et, pocP, xloc=xloc.bar_time, extend=ext, color=showPoc ? pocCol : na, width=2))
    array.push(ln, line.new(st, vahP, et, vahP, xloc=xloc.bar_time, extend=ext, color=showVa ? vaLnCol : na, style=line.style_dashed))
    array.push(ln, line.new(st, valP, et, valP, xloc=xloc.bar_time, extend=ext, color=showVa ? vaLnCol : na, style=line.style_dashed))

// ============================================================================
// INTRABAR DATA
// ============================================================================
float[] lh = na
float[] ll = na
float[] lv = na
if ltfOk
    [h_, l_, v_] = request.security_lower_tf(syminfo.tickerid, ltf, [high, low, volume])
    lh := h_
    ll := l_
    lv := v_

// ============================================================================
// MAIN LOOP
// ============================================================================
// 1) Finalize previous profile
if closeCond and array.size(hs) > 0
    render(startT, lastT + barMs, hPl, hLn, false)
    array.clear(hs)
    array.clear(ls)
    array.clear(vs)
    while array.size(hPl) > maxProf * 2
        polyline.delete(array.shift(hPl))
    while array.size(hLn) > maxProf * 3
        line.delete(array.shift(hLn))

// 2) Accumulate current bar (intrabar candles if available, else the bar itself)
if addCond
    if array.size(hs) == 0
        startT := time
    int m = ltfOk ? array.size(lh) : 0
    if m > 0
        for i = 0 to m - 1
            float ih = array.get(lh, i)
            float il = array.get(ll, i)
            if not na(ih) and not na(il)
                array.push(hs, ih)
                array.push(ls, il)
                array.push(vs, nz(array.get(lv, i)))
    else
        array.push(hs, high)
        array.push(ls, low)
        array.push(vs, volume)
    lastT := time

// 3) Developing (live) profile
if barstate.islast
    while array.size(dPl) > 0
        polyline.delete(array.pop(dPl))
    while array.size(dLn) > 0
        line.delete(array.pop(dLn))
    if array.size(hs) > 0
        render(startT, time + barMs, dPl, dLn, true)
